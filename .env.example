# KIS Developers 앱키/시크릿 (https://apiportal.koreainvestment.com)
KIS_APP_KEY=
KIS_APP_SECRET=

# 계좌번호: 8자리-2자리 중 앞 8자리 / 뒤 2자리(상품코드, 보통 01)
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRODUCT_CODE=01

# true: 모의투자 도메인 사용 (실자금 영향 없음) / false: 실전투자
IS_VIRTUAL=true

# true: 신호 계산만 하고 실제 주문은 내지 않음 (로그로만 확인)
DRY_RUN=true

# DRY_RUN=false 이고 IS_VIRTUAL=false(실전) 일 때만 확인되는 추가 안전 스위치.
# 실계좌 자동매매를 시작할 준비가 되었을 때만 YES로 변경하세요.
CONFIRM_LIVE_TRADING=NO

# 쉼표로 구분된 관심 종목코드 (예: 삼성전자, SK하이닉스)
WATCHLIST=005930,000660

# 전략 파라미터
SHORT_MA=5
LONG_MA=20
CANDLE_INTERVAL_MIN=1

# 리스크 관리
MAX_POSITION_PCT=10
MAX_CONCURRENT_POSITIONS=3
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=3
DAILY_LOSS_LIMIT_PCT=5

# 매매 사이클 주기(초)
POLL_INTERVAL_SEC=30

# 한 사이클 내에서 종목별 API 호출 사이 대기(초). KIS 요청 제한(특히 모의투자)을 피하기 위함
REQUEST_INTERVAL_SEC=0.3

# 장마감 강제청산 시각 (HH:MM, 이 시각 이후 보유 포지션 전량 시장가 매도)
FORCE_CLOSE_TIME=15:20

# DRY_RUN=true일 때 모의로 굴릴 가상 시작 자금(원)
DRY_RUN_STARTING_CASH=10000000
